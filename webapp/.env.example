# Damirchi Web App Environment
# Render backend API link. /api yozilsa ham, yozilmasa ham client avtomatik normallashtiradi.
VITE_API_URL=https://damirchi-bobo-api.onrender.com/api

# Render backend root link. Media/images uchun kerak.
VITE_BACKEND_URL=https://damirchi-bobo-api.onrender.com

# Faqat backend ishlamasa frontendni ko‘rish uchun true qiling.
# Productionda false bo‘lsin.
VITE_USE_MOCK_DATA=false
