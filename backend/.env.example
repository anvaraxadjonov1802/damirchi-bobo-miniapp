# Django
SECRET_KEY=your_django_secret_key_here
DEBUG=False

# Render backend domain (https:// yozilmaydi)
ALLOWED_HOSTS=damirchi-bobo-api.onrender.com,localhost,127.0.0.1

# MongoDB Atlas
# Haqiqiy username/passwordni GitHubga yozmang.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@damirchi.jfuzgwi.mongodb.net/?retryWrites=true&w=majority&appName=damirchi
MONGODB_DB_NAME=damirchi

# Frontend CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://damirchi.vercel.app
CSRF_TRUSTED_ORIGINS=https://damirchi.vercel.app

# Telegram integration
BOT_TOKEN=your_telegram_bot_token_here
OPERATOR_CHAT_ID=-1001234567890
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Bot va backend orasidagi maxfiy kalit. Ikki servisda ham bir xil bo'lsin.
OPERATOR_API_KEY=generate_a_long_random_secret_here

# Productionda False bo'lsin.
# True bo'lsa browserdan Telegram initData'siz order yuborish mumkin (faqat local test uchun).
ALLOW_UNVERIFIED_TELEGRAM_IN_DEBUG=False

# Payment return URL (Vercel Mini App URL yoki maxsus payment result sahifa)
PAYMENT_RETURN_URL=https://damirchi.vercel.app

# Click
# Merchant kabinetdan berilgan qiymatlarni faqat .env/Render Environment'ga yozing.
CLICK_ENABLED=False
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# Click cabinet callback URLs after deploy:
# Prepare:  https://damirchi-bobo-api.onrender.com/api/payments/click/prepare/
# Complete: https://damirchi-bobo-api.onrender.com/api/payments/click/complete/

# Payme
# PAYME_LOGIN — Payme Business texnik mutaxassisi bergan Merchant API login.
# PAYME_SECRET_KEY — web-kassa kaliti/paroli.
PAYME_ENABLED=False
PAYME_MERCHANT_ID=
PAYME_LOGIN=
PAYME_SECRET_KEY=
PAYME_ACCOUNT_FIELD=order_id
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Payme Merchant API URL after deploy:
# https://damirchi-bobo-api.onrender.com/api/payments/payme/

# Media storage database'dan alohida ishlaydi.
# Hozircha Supabase Storage'ni saqlab turish mumkin; keyin alohida object storage'ga ko'chiramiz.
USE_SUPABASE_STORAGE=True
SUPABASE_STORAGE_BUCKET=damirchi-media
SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION_NAME=auto
SUPABASE_S3_ACCESS_KEY_ID=your_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_secret_access_key
